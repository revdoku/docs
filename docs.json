{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Revdoku Docs",
  "colors": { "primary": "#2563eb" },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      { "label": "Dashboard", "href": "https://app.revdoku.com/buckets" },
      { "type": "github", "href": "https://github.com/revdoku/docs" }
    ],
    "primary": { "label": "Start Free", "href": "https://app.revdoku.com/users/sign_up" }
  },
  "navigation": {
    "groups": [
      { "group": "Get started", "pages": ["index", "quickstart", "docs-sites", "coding-agents", "support"] },
      {
        "group": "Guides",
        "pages": [
          "buckets",
          "api",
          "guides/authentication",
          "guides/bulk-uploads",
          "guides/email-events",
          "guides/ask-security-check",
          "guides/custom-email-domains",
          "guides/api-packages"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "api-reference/index",
          "api-reference/console",
          "api-reference/authentication",
          "api-reference/accounts",
          "api-reference/buckets",
          "api-reference/files",
          "api-reference/github",
          "api-reference/publications",
          "api-reference/tickets",
          "api-reference/events"
        ]
      },
      { "group": "SDKs and tools", "pages": ["sdks/typescript", "sdks/python", "mcp", "cli"] },
      { "group": "Changelog", "pages": ["changelog"] }
    ]
  },
  "openapi": "openapi.json",
  "contextual": { "options": ["copy", "view", "assistant", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"] },
  "footer": {
    "socials": { "github": "https://github.com/revdoku" },
    "links": [
      {
        "header": "Revdoku",
        "items": [
          { "label": "Website", "href": "https://revdoku.com" },
          { "label": "Changelog", "href": "/changelog" },
          { "label": "Support", "href": "/support" }
        ]
      },
      {
        "header": "Legal",
        "items": [
          { "label": "Terms of Use", "href": "https://revdoku.com/terms/" },
          { "label": "Privacy Policy", "href": "https://revdoku.com/privacy/" }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/docs", "destination": "/" },
    { "source": "/docs/quickstart", "destination": "/quickstart" },
    { "source": "/docs/coding-agents", "destination": "/coding-agents" },
    { "source": "/docs/sdks/:slug*", "destination": "/sdks/:slug*" },
    { "source": "/api/reference", "destination": "/api-reference" },
    { "source": "/api/reference/:slug*", "destination": "/api-reference/:slug*" },
    { "source": "/api-reference/emails", "destination": "/api-reference/tickets" },
    { "source": "/api-reference/mailbox", "destination": "/api-reference/buckets" },
    { "source": "/api-reference/email-domains", "destination": "/guides/custom-email-domains" },
    { "source": "/guides/saas-mailboxes", "destination": "/buckets" }
  ]
}
